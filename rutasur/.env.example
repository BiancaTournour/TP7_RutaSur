# Copiar a .env para cambiar los parametros del simulador (docker compose los toma solo).
# Reiniciar el simulador despues de cambiarlos:  docker compose up -d simulador

# 1 hora simulada = 30 s reales  ->  120
ACELERACION=120
# Semilla fija: la misma corrida se repite exactamente (para recontar a mano)
SEMILLA=rutasur-2026
ENVIOS_POR_MINUTO=20
PROB_DEMORA_HUB=0.1
TASA_DUPLICADO=0.02
TASA_FUERA_DE_ORDEN=0.02
TASA_MALFORMADO=0.01
# la franja TARDE falla un poco mas que la MANANA (multiplica la tasa base de la zona)
FACTOR_TARDE=1.25
